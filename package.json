{
  "name": "task-thing-monorepo",
  "version": "1.0.5",
  "description": "Task Thing — Get your things together (Desktop Widget & Mobile App)",
  "private": true,
  "scripts": {
    "desktop": "pnpm --dir desktop start",
    "desktop:pack": "pnpm --dir desktop pack",
    "desktop:dist:win": "pnpm --dir desktop dist:win",
    "desktop:dist:mac": "pnpm --dir desktop dist:mac",
    "desktop:dist:linux": "pnpm --dir desktop dist:linux",
    "desktop:dist:all": "pnpm --dir desktop dist:all",
    "mobile:dev": "pnpm --dir mobile dev",
    "mobile:build": "pnpm --dir mobile build",
    "mobile:sync": "pnpm --dir mobile cap:sync",
    "mobile:android": "pnpm --dir mobile cap:android",
    "mobile:ios": "pnpm --dir mobile cap:ios"
  },
  "packageManager": "pnpm@12.18.0"
}
