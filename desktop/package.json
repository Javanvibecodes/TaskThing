{
  "name": "task-thing-desktop",
  "version": "1.0.0",
  "description": "Task Thing — Get your things together",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.taskthing.widget",
    "productName": "Task Thing",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    },
    "files": [
      "src/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "widget",
    "tasks",
    "desktop",
    "productivity"
  ],
  "author": "tasks.core",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.2.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.22.1"
  }
}
