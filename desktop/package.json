{
  "name": "task-thing-desktop",
  "version": "1.0.0",
  "description": "Task Thing — Get your things together",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -mwl"
  },
  "build": {
    "appId": "com.taskthing.widget",
    "productName": "Task Thing",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Utility"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "icon": "src/assets/blob.png"
  },
  "keywords": [
    "widget",
    "tasks",
    "desktop",
    "productivity"
  ],
  "author": "Task Thing",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.2.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.22.1"
  }
}